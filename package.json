{
  "name": "mizuki-oyama-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "astro dev --host 127.0.0.1",
    "check": "astro check && npm run validate:content",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run validate:content -- --public-only && NODE_ENV=production astro build",
    "preview": "astro preview --host 127.0.0.1",
    "article:new": "node scripts/article-workflow.mjs new",
    "article:save": "node scripts/article-workflow.mjs save",
    "article:asset": "node scripts/article-workflow.mjs asset",
    "article:list": "node scripts/article-workflow.mjs list",
    "article:validate": "node scripts/article-workflow.mjs validate",
    "article:status": "node scripts/article-workflow.mjs status",
    "article:backup": "node scripts/article-workflow.mjs backup",
    "article:restore": "node scripts/article-workflow.mjs restore",
    "article:recover": "node scripts/article-workflow.mjs recover",
    "article:preview": "node scripts/article-workflow.mjs preview",
    "article:publish:prepare": "node scripts/article-publication.mjs prepare",
    "article:publish:record-approval": "node scripts/article-publication.mjs record-approval",
    "article:publish:check-approval": "node scripts/article-publication.mjs check-approval",
    "article:publish:check-git-scope": "node scripts/article-publication.mjs check-git-scope",
    "article:publish:materialize": "node scripts/article-publication.mjs materialize",
    "article:publish:verify": "node scripts/article-publication.mjs verify",
    "test:articles": "node --test --test-concurrency=2"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3"
  }
}
