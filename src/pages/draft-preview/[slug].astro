---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPrivateDraftIdFromEntryPath,
  getPrivateDraftImageMetadata,
  privateDraftAssetUrl,
} from '../../lib/private-draft-assets.mjs';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const drafts = await getCollection('localDrafts');
  return drafts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const canonical = new URL(base + 'draft-preview/' + post.data.slug + '/', Astro.url).href;
const projectRoot = new URL('../../../', import.meta.url);
const draftId = getPrivateDraftIdFromEntryPath({
  root: projectRoot,
  entryPath: post.filePath,
});

async function getDraftImage(reference: string | undefined) {
  if (!reference) return undefined;
  const metadata = await getPrivateDraftImageMetadata({
    root: projectRoot,
    draftId,
    reference,
  });
  return {
    src: privateDraftAssetUrl(draftId, reference),
    width: metadata.width,
    height: metadata.height,
  };
}

const coverImage = await getDraftImage(post.data.cover);
const ogImageAsset = await getDraftImage(post.data.ogImage);
const ogImage = ogImageAsset ? new URL(ogImageAsset.src, Astro.url).href : undefined;
const isoDate = post.data.pubDate.toISOString();
const published = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long', timeZone: 'UTC' }).format(post.data.pubDate);
const pageTitle = post.data.seoTitle ?? post.data.title + '｜Mizuki Oyama Journal';
const articleData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: '小山瑞樹' },
  publisher: { '@type': 'Person', name: '小山瑞樹' },
};
---
<BaseLayout title={pageTitle} description={post.data.description} canonical={canonical} robots="noindex, nofollow" ogType="article" publishedTime={isoDate} structuredData={articleData} ogImage={ogImage} ogImageAlt={post.data.ogImageAlt}>
  <article class="article page-width">
    <nav class="breadcrumbs" aria-label="パンくずリスト"><a href={base}>記事一覧</a><span aria-hidden="true">/</span><a href={base + 'categories/' + post.data.category.toLowerCase() + '/'}>{post.data.category}</a></nav>
    <p class="draft-notice">ローカル下書きプレビューです。このURLは開発サーバーでのみ利用でき、公開ビルドには含まれません。</p>
    <header class="article-header">
      <p class="eyebrow">{post.data.category} <span>—</span> {published}</p>
      <h1>{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>
      {coverImage && (
        <figure class="article-cover">
          <img src={coverImage.src} alt={post.data.coverAlt ?? ''} width={coverImage.width} height={coverImage.height} loading="eager" decoding="async" class="article-cover__image" />
          {post.data.coverAlt && <figcaption>{post.data.coverAlt}</figcaption>}
        </figure>
      )}
    </header>
    <div class="article-body"><Content /></div>
    {post.data.tags.length > 0 && <ul class="tag-list" aria-label="タグ">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    <a class="back-link article-back" href={base + 'categories/' + post.data.category.toLowerCase() + '/'}>← {post.data.category}の記事へ戻る</a>
  </article>
</BaseLayout>
