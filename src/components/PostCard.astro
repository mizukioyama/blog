---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  preview?: boolean;
  loading?: 'eager' | 'lazy';
}

const { post, preview = false, loading = 'lazy' } = Astro.props;
const base = import.meta.env.BASE_URL;
const published = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long', timeZone: 'UTC' }).format(post.data.pubDate);
---
<article class="post-card">
  <a class="post-card__link" href={base + 'posts/' + post.data.slug + '/'}>
    <div class="post-card__visual">
      {post.data.cover ? (
        <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} width={post.data.cover.width} height={post.data.cover.height} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw" loading={loading} class="post-card__image" />
      ) : (
        <div class={'post-card__placeholder post-card__placeholder--' + post.data.category.toLowerCase()} aria-hidden="true">
          <span>{post.data.category}</span><i></i><i></i><i></i>
        </div>
      )}
      {preview && <span class="draft-badge">下書き・開発プレビューのみ</span>}
    </div>
    <div class="post-card__body">
      <p class="post-card__meta"><span>{post.data.category}</span><time datetime={post.data.pubDate.toISOString()}>{published}</time></p>
      <h2>{post.data.title}</h2>
      <p class="post-card__description">{post.data.description}</p>
      <span class="text-link">続きを読む <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
