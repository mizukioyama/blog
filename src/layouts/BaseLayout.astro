---
import '../styles/global.css';
import { categories } from '../lib/categories';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  structuredData?: Record<string, unknown>; ogImage?: string | undefined; ogImageAlt?: string | undefined;
}

const { title, description, canonical, robots = 'index, follow', ogType = 'website', publishedTime, structuredData, ogImage: pageOgImage, ogImageAlt: pageOgImageAlt } = Astro.props;
const ogImageAlt = pageOgImageAlt ?? '淡いオリーブ色と青紫色の面にゆらぐ線を重ねた抽象イラスト。';
const base = import.meta.env.BASE_URL;
const ogImage = pageOgImage ?? new URL(base + 'og-image.png', Astro.site ?? Astro.url).href;
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : undefined;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4ed" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:site_name" content="Mizuki Oyama Journal" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Mizuki Oyama Journal ホーム">
        <span class="brand__name">MIZUKI OYAMA</span>
        <span class="brand__sub">Journal / 作品と活動の記録</span>
      </a>
      <nav class="site-nav" aria-label="メインナビゲーション">
        <a href={base}>Home</a>
        {categories.map((category) => (
          <a href={base + 'categories/' + category.slug + '/'}>{category.name}</a>
        ))}
        <a class="site-nav__external" href="https://mizukioyama.github.io/website/" target="_blank" rel="noopener noreferrer">Portfolio <span aria-hidden="true">↗</span></a>
      </nav>
      <button class="mobile-menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu" aria-haspopup="dialog">
        <span class="mobile-menu-toggle__icon" aria-hidden="true"></span>
      </button>
    </header>
  <dialog class="mobile-menu" id="mobile-menu" aria-label="メインメニュー">
    <div class="mobile-menu__panel">
      <div class="mobile-menu__heading">
        <span class="eyebrow">MENU</span>
        <button class="mobile-menu__close" type="button" aria-label="メニューを閉じる">×</button>
      </div>
      <nav class="mobile-menu__nav" aria-label="モバイルナビゲーション">
        <a href={base}>Home</a>
        {categories.map((category) => (
          <a href={base + 'categories/' + category.slug + '/'}>{category.name}</a>
        ))}
        <a class="site-nav__external" href="https://mizukioyama.github.io/website/" target="_blank" rel="noopener noreferrer">Portfolio <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </dialog>
  <main id="main"><slot /></main>
    <footer class="site-footer">
      <a class="brand brand--footer" href={base}>
        <span class="brand__name">MIZUKI OYAMA</span>
        <span class="brand__sub">Art / Exhibition / Creative</span>
      </a>
      <p>感じたこと、つくったもの、その間にある時間。</p>
      <small>© {new Date().getFullYear()} Mizuki Oyama</small>
    <nav class="site-footer__links" aria-label="関連サイトとカテゴリー">
      <a href="https://mizukioyama.github.io/website/" target="_blank" rel="noopener noreferrer">Portfolio</a>
      <a href="https://mizukioyama.github.io/yurayura/" target="_blank" rel="noopener noreferrer">ゆらゆら公式サイト</a>
      {categories.map((category) => <a href={base + 'categories/' + category.slug + '/'}>{category.name}</a>)}
    </nav>
    </footer>
  <script>
  const mobileMenu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const mobileMenuToggle = document.querySelector<HTMLButtonElement>(".mobile-menu-toggle");
  const mobileMenuClose = mobileMenu?.querySelector<HTMLButtonElement>(".mobile-menu__close");
  const mobileMenuPanel = mobileMenu?.querySelector<HTMLElement>(".mobile-menu__panel");
  const mobileBreakpoint = window.matchMedia("(max-width: 1024px)");
  const toggleOrigin = mobileMenuToggle ? document.createComment("mobile-menu-toggle-origin") : null;
  if (mobileMenuToggle?.parentNode && toggleOrigin) mobileMenuToggle.parentNode.insertBefore(toggleOrigin, mobileMenuToggle);

  let closeTimeout = 0;
  let closeTransitionEnd: ((event: TransitionEvent) => void) | null = null;
  let focusAfterClose: HTMLElement | null = mobileMenuToggle;

  const setExpanded = (expanded: boolean) => {
    mobileMenuToggle?.setAttribute("aria-expanded", String(expanded));
    mobileMenuToggle?.setAttribute("aria-label", expanded ? "メニューを閉じる" : "メニューを開く");
  };

  const parseCssTime = (value: string) => {
    const time = Number.parseFloat(value);
    if (!Number.isFinite(time)) return 0;
    return value.trim().endsWith("ms") ? time : value.trim().endsWith("s") ? time * 1000 : 0;
  };

  const transitionDuration = (element: Element) => {
    const style = window.getComputedStyle(element);
    const durations = style.transitionDuration.split(",").map(parseCssTime);
    const delays = style.transitionDelay.split(",").map(parseCssTime);
    return Math.max(0, ...durations.map((duration, index) => duration + delays[index % delays.length]!));
  };

  const clearPendingClose = () => {
    if (closeTimeout) window.clearTimeout(closeTimeout);
    closeTimeout = 0;
    if (closeTransitionEnd && mobileMenuPanel) mobileMenuPanel.removeEventListener("transitionend", closeTransitionEnd);
    closeTransitionEnd = null;
  };

  const moveToggleIntoDialog = () => {
    if (mobileMenu && mobileMenuToggle && !mobileMenu.contains(mobileMenuToggle)) mobileMenu.append(mobileMenuToggle);
  };

  const restoreToggle = () => {
    if (mobileMenu && mobileMenuToggle && toggleOrigin && toggleOrigin.parentNode && mobileMenu.contains(mobileMenuToggle)) {
      toggleOrigin.parentNode.insertBefore(mobileMenuToggle, toggleOrigin.nextSibling);
    }
  };

  const resumeMenu = () => {
    if (!mobileMenu?.open) return;
    clearPendingClose();
    focusAfterClose = mobileMenuToggle;
    mobileMenu.dataset.state = "open";
    mobileMenuClose?.focus();
  };

  const closeMenu = (focusTarget: HTMLElement | null = mobileMenuToggle) => {
    if (!mobileMenu?.open || mobileMenu.dataset.state === "closing") return;
    clearPendingClose();
    focusAfterClose = focusTarget;
    mobileMenu.dataset.state = "closing";
    const duration = window.matchMedia("(prefers-reduced-motion: reduce)").matches || !mobileMenuPanel
      ? 0
      : transitionDuration(mobileMenuPanel);
    if (duration <= 0) {
      mobileMenu.close();
      return;
    }
    closeTransitionEnd = (event: TransitionEvent) => {
      if (event.target === mobileMenuPanel && event.propertyName === "opacity") mobileMenu.close();
    };
    mobileMenuPanel?.addEventListener("transitionend", closeTransitionEnd);
    closeTimeout = window.setTimeout(() => {
      if (mobileMenu.open && mobileMenu.dataset.state === "closing") mobileMenu.close();
    }, duration + 80);
  };

  const openMenu = () => {
    if (!mobileMenu) return;
    if (mobileMenu.open) {
      if (mobileMenu.dataset.state === "closing") resumeMenu();
      return;
    }
    clearPendingClose();
    focusAfterClose = mobileMenuToggle;
    mobileMenu.dataset.state = "opening";
    moveToggleIntoDialog();
    mobileMenu.showModal();
    document.documentElement.classList.add("mobile-menu-open");
    setExpanded(true);
    window.requestAnimationFrame(() => {
      if (!mobileMenu.open || mobileMenu.dataset.state !== "opening") return;
      mobileMenu.dataset.state = "open";
      mobileMenuClose?.focus();
    });
  };

  mobileMenuToggle?.addEventListener("click", () => {
    if (!mobileMenu?.open) openMenu();
    else if (mobileMenu.dataset.state === "closing") resumeMenu();
    else closeMenu();
  });

  mobileMenu?.addEventListener("close", () => {
    clearPendingClose();
    restoreToggle();
    delete mobileMenu.dataset.state;
    document.documentElement.classList.remove("mobile-menu-open");
    setExpanded(false);
    const target = focusAfterClose;
    focusAfterClose = mobileMenuToggle;
    if (target?.isConnected) target.focus();
  });

  mobileMenu?.addEventListener("cancel", (event) => {
    event.preventDefault();
    if (mobileMenu.dataset.state === "closing") resumeMenu();
    else closeMenu();
  });

  mobileMenu?.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    const focusable = [...mobileMenu.querySelectorAll<HTMLAnchorElement | HTMLButtonElement>("a[href], button:not([disabled])")]
      .filter((element) => element.getClientRects().length > 0);
    if (!focusable.length) return;
    const first = focusable[0]!;
    const last = focusable[focusable.length - 1]!;
    const focusIsInside = mobileMenu.contains(document.activeElement);
    if (event.shiftKey && (document.activeElement === first || !focusIsInside)) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && (document.activeElement === last || !focusIsInside)) {
      event.preventDefault();
      first.focus();
    }
  });

  mobileMenu?.addEventListener("click", (event) => {
    if (event.target === mobileMenu) closeMenu();
  });

  mobileMenuClose?.addEventListener("click", () => {
    if (mobileMenu?.dataset.state === "closing") resumeMenu();
    else closeMenu();
  });

  mobileMenu?.querySelectorAll<HTMLAnchorElement>("nav a").forEach((link) => {
    link.addEventListener("click", () => closeMenu(null));
  });

  mobileBreakpoint.addEventListener("change", (event) => {
    if (!event.matches && mobileMenu?.open) {
      closeMenu(document.querySelector<HTMLAnchorElement>(".site-nav a"));
    }
  });
  </script>
</body>
</html>
